<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="xpass_defs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="pool" name="xPass ML service" processRef="xpass_process"/>
  </bpmn:collaboration>
  <bpmn:process id="xpass_process" name="xPass ML lifecycle" isExecutable="false">
    <bpmn:laneSet id="laneset"><bpmn:lane id="lane_data" name="Data pipeline"><bpmn:flowNodeRef>start_data</bpmn:flowNodeRef><bpmn:flowNodeRef>t_ingest</bpmn:flowNodeRef><bpmn:flowNodeRef>t_clean</bpmn:flowNodeRef><bpmn:flowNodeRef>t_features</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_model" name="Modelling"><bpmn:flowNodeRef>t_train</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_gate</bpmn:flowNodeRef><bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>t_save</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_serve" name="CI/CD &amp; Serving"><bpmn:flowNodeRef>t_ci</bpmn:flowNodeRef><bpmn:flowNodeRef>t_deploy</bpmn:flowNodeRef><bpmn:flowNodeRef>t_serve</bpmn:flowNodeRef><bpmn:flowNodeRef>end_live</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_mon" name="Monitoring"><bpmn:flowNodeRef>start_timer</bpmn:flowNodeRef><bpmn:flowNodeRef>t_drift</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_drift</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>t_issue</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start_data" name="New tournament data available"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t_ingest" name="Download StatsBomb events + 360 frames"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:task><bpmn:task id="t_clean" name="Clean + validate in-play passes"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task><bpmn:task id="t_features" name="Build 13 features (shared with API)"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task><bpmn:task id="t_train" name="Train + calibrate candidates (split by match)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_gate" name="Evaluation gate passed?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="end_rejected" name="Model rejected, not deployed"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent><bpmn:task id="t_save" name="Save versioned model + metadata"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task><bpmn:task id="t_ci" name="Run tests + build Docker image"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task><bpmn:task id="t_deploy" name="Deploy new Cloud Run revision"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task><bpmn:task id="t_serve" name="Serve /predict + log predictions"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end_live" name="Service live"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent><bpmn:startEvent id="start_timer" name="Every Monday"><bpmn:outgoing>f11</bpmn:outgoing><bpmn:timerEventDefinition id="timer_def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1W</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:task id="t_drift" name="Drift check (PSI, Brier, coverage)"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_drift" name="Retraining recommended?"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="end_ok" name="No action"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent><bpmn:task id="t_issue" name="Open GitHub issue: retrain"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task><bpmn:sequenceFlow id="f0" sourceRef="start_data" targetRef="t_ingest"/><bpmn:sequenceFlow id="f1" sourceRef="t_ingest" targetRef="t_clean"/><bpmn:sequenceFlow id="f2" sourceRef="t_clean" targetRef="t_features"/><bpmn:sequenceFlow id="f3" sourceRef="t_features" targetRef="t_train"/><bpmn:sequenceFlow id="f4" sourceRef="t_train" targetRef="gw_gate"/><bpmn:sequenceFlow id="f5" name="yes" sourceRef="gw_gate" targetRef="t_save"/><bpmn:sequenceFlow id="f6" name="no" sourceRef="gw_gate" targetRef="end_rejected"/><bpmn:sequenceFlow id="f7" sourceRef="t_save" targetRef="t_ci"/><bpmn:sequenceFlow id="f8" sourceRef="t_ci" targetRef="t_deploy"/><bpmn:sequenceFlow id="f9" sourceRef="t_deploy" targetRef="t_serve"/><bpmn:sequenceFlow id="f10" sourceRef="t_serve" targetRef="end_live"/><bpmn:sequenceFlow id="f11" sourceRef="start_timer" targetRef="t_drift"/><bpmn:sequenceFlow id="f12" sourceRef="t_drift" targetRef="gw_drift"/><bpmn:sequenceFlow id="f13" name="yes" sourceRef="gw_drift" targetRef="t_issue"/><bpmn:sequenceFlow id="f14" name="no" sourceRef="gw_drift" targetRef="end_ok"/><bpmn:sequenceFlow id="f15" name="triggers retraining" sourceRef="t_issue" targetRef="start_data"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="1640" height="680"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_data_di" bpmnElement="lane_data" isHorizontal="true"><dc:Bounds x="130" y="60" width="1610" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_model_di" bpmnElement="lane_model" isHorizontal="true"><dc:Bounds x="130" y="230" width="1610" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_serve_di" bpmnElement="lane_serve" isHorizontal="true"><dc:Bounds x="130" y="400" width="1610" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="lane_mon_di" bpmnElement="lane_mon" isHorizontal="true"><dc:Bounds x="130" y="570" width="1610" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_data_di" bpmnElement="start_data"><dc:Bounds x="182.0" y="127.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="152.0" y="167.0" width="96" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_ingest_di" bpmnElement="t_ingest"><dc:Bounds x="280.0" y="105.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_clean_di" bpmnElement="t_clean"><dc:Bounds x="440.0" y="105.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_features_di" bpmnElement="t_features"><dc:Bounds x="600.0" y="105.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_train_di" bpmnElement="t_train"><dc:Bounds x="760.0" y="275.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw_gate_di" bpmnElement="gw_gate" isMarkerVisible="true"><dc:Bounds x="945.0" y="290.0" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="925.0" y="258.0" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected"><dc:Bounds x="952.0" y="365.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="922.0" y="405.0" width="96" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_save_di" bpmnElement="t_save"><dc:Bounds x="1050.0" y="275.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_ci_di" bpmnElement="t_ci"><dc:Bounds x="1050.0" y="445.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_deploy_di" bpmnElement="t_deploy"><dc:Bounds x="1210.0" y="445.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_serve_di" bpmnElement="t_serve"><dc:Bounds x="1370.0" y="445.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_live_di" bpmnElement="end_live"><dc:Bounds x="1572.0" y="467.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1542.0" y="507.0" width="96" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="start_timer_di" bpmnElement="start_timer"><dc:Bounds x="182.0" y="637.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="152.0" y="677.0" width="96" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_drift_di" bpmnElement="t_drift"><dc:Bounds x="280.0" y="615.0" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="gw_drift_di" bpmnElement="gw_drift" isMarkerVisible="true"><dc:Bounds x="475.0" y="630.0" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="455.0" y="598.0" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="482.0" y="705.0" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="452.0" y="745.0" width="96" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t_issue_di" bpmnElement="t_issue"><dc:Bounds x="680.0" y="615.0" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f0_di" bpmnElement="f0"><di:waypoint x="218" y="145"/><di:waypoint x="280" y="145"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="400" y="145"/><di:waypoint x="440" y="145"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="560" y="145"/><di:waypoint x="600" y="145"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="720" y="145"/><di:waypoint x="740" y="145"/><di:waypoint x="740" y="315"/><di:waypoint x="760" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="880" y="315"/><di:waypoint x="945" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="995" y="315"/><di:waypoint x="1050" y="315"/><bpmndi:BPMNLabel><dc:Bounds x="962" y="297" width="120" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="970" y="340"/><di:waypoint x="970" y="365"/><bpmndi:BPMNLabel><dc:Bounds x="926" y="346" width="120" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1110" y="355"/><di:waypoint x="1110" y="445"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1170" y="485"/><di:waypoint x="1210" y="485"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1330" y="485"/><di:waypoint x="1370" y="485"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1490" y="485"/><di:waypoint x="1572" y="485"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="218" y="655"/><di:waypoint x="280" y="655"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="400" y="655"/><di:waypoint x="475" y="655"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="525" y="655"/><di:waypoint x="680" y="655"/><bpmndi:BPMNLabel><dc:Bounds x="542" y="637" width="120" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="500" y="680"/><di:waypoint x="500" y="705"/><bpmndi:BPMNLabel><dc:Bounds x="456" y="686" width="120" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="740" y="615"/><di:waypoint x="740" y="588"/><di:waypoint x="168" y="588"/><di:waypoint x="168" y="145"/><di:waypoint x="182" y="145"/><bpmndi:BPMNLabel><dc:Bounds x="394" y="572" width="120" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
